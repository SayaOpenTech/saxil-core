    "Do not invent AST constructs beyond SemanticFrame/VerbalUtt supported by W2."
  ],
  "critical_coverage_acceptance": {
    "ENT": "At least one independent valid object Ent (with and without name) + one invalid eid",
    "NUM": "Independent zero, non-zero currency unit, KIND_DIGITS path + invalid negative via encode contract",
    "DATE": "Independent calendar Date on TAG_TIME + invalid month on wire",
    "CMP": "Independent comparison with ASCII left + Num right + invalid op on wire",
    "PASS_requires": "All listed positive vectors encode/decode to hand-derived hex; negatives reject with documented codes"
  },
